{
  "name": "vislite",
  "version": "1.12.0",
  "description": "灵活、快速、简单的数据可视化交互式跨端前端库",
  "main": "./lib/index.umd.min.js",
  "module": "./lib/index.es.js",
  "types": "./types/index.d.ts",
  "typings": "./types/index.d.ts",
  "unpkg": "./lib/index.umd.min.js",
  "jsdelivr": "./lib/index.umd.min.js",
  "sideEffects": false,
  "files": [
    "lib",
    "types",
    "uni-app",
    "miniprogram",
    "minialipay",
    "README.md",
    "README-en.md",
    "CHANGELOG",
    "LICENSE",
    "AUTHORS.txt",
    ".mailmap"
  ],
  "scripts": {
    "install:all": "npm install && npm run install:uniapp2 && npm run install:uniapp3 && npm run install:alipay && npm run install:miniprogram",
    "install:uniapp2": "npm --prefix test/uniapp2 install",
    "install:uniapp3": "npm --prefix test/uniapp3 install",
    "install:alipay": "npm --prefix test/alipay install && npm --prefix test/alipay run build",
    "install:miniprogram": "npm --prefix test/miniprogram install",
    "dev": "webpack serve --config ./build/webpack.config.js",
    "build": "oipage-cli disk -d ./lib && node ./build/pkg.js",
    "test": "karma start ./build/karma.config.js --single-run",
    "test:ci": "karma start ./build/karma.config.js --single-run",
    "test:unit": "npm run test --workspace @vislite/unit",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"src/**/*.ts\" \"package/**/*.ts\" --fix",
    "build:uniapp2:h5": "npm --prefix test/uniapp2 run build:h5",
    "build:uniapp2:mp-alipay": "npm --prefix test/uniapp2 run build:mp-alipay",
    "build:uniapp2:mp-weixin": "npm --prefix test/uniapp2 run build:mp-weixin",
    "dev:uniapp2:h5": "npm --prefix test/uniapp2 run dev:h5",
    "dev:uniapp2:mp-alipay": "npm --prefix test/uniapp2 run dev:mp-alipay",
    "dev:uniapp2:mp-weixin": "npm --prefix test/uniapp2 run dev:mp-weixin",
    "build:uniapp3:h5": "npm --prefix test/uniapp3 run build:h5",
    "build:uniapp3:mp-alipay": "npm --prefix test/uniapp3 run build:mp-alipay",
    "build:uniapp3:mp-weixin": "npm --prefix test/uniapp3 run build:mp-weixin",
    "dev:uniapp3:h5": "npm --prefix test/uniapp3 run dev:h5",
    "dev:uniapp3:mp-alipay": "npm --prefix test/uniapp3 run dev:mp-alipay",
    "dev:uniapp3:mp-weixin": "npm --prefix test/uniapp3 run dev:mp-weixin"
  },
  "workspaces": [
    "test/benchmark",
    "test/example",
    "test/scriptTag",
    "test/unit",
    "cli"
  ],
  "miniprogram": ".",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/oi-contrib/VISLite.git"
  },
  "keywords": [
    "svg",
    "webgl",
    "typescript",
    "canvas",
    "vue",
    "uniapp",
    "miniprogram",
    "image2d",
    "image3d",
    "oi-contrib",
    "vislite",
    "d3",
    "zxl20070701",
    "three",
    "echarts",
    "datav",
    "webgpu",
    "layout",
    "algorithm"
  ],
  "author": {
    "name": "zxl20070701",
    "url": "https://zxl20070701.github.io/notebook/home.html"
  },
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/oi-contrib/VISLite/issues"
  },
  "homepage": "https://oi-contrib.github.io/VISLite",
  "devDependencies": {
    "@oipage/cli": "^0.2.1",
    "@rollup/plugin-commonjs": "^25.0.7",
    "@rollup/plugin-node-resolve": "^15.2.3",
    "@rollup/plugin-typescript": "^11.1.0",
    "@types/jasmine": "^4.3.1",
    "@typescript-eslint/eslint-plugin": "^8.62.1",
    "@typescript-eslint/parser": "^8.62.1",
    "eslint": "^8.57.0",
    "karma": "^6.3.10",
    "karma-chrome-launcher": "^3.1.0",
    "karma-jasmine": "^4.0.1",
    "karma-webpack": "^5.0.0",
    "oipage": "^2.1.0",
    "rollup": "^3.20.6",
    "terser": "^5.17.1",
    "ts-loader": "^9.2.8",
    "tslib": "^2.5.0",
    "typescript": "^4.6.2",
    "webpack": "^5.108.0",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^6.0.0"
  }
}
